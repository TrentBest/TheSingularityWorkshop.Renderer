<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TheSingularityWorkshop.Renderer</PackageId>
    <Version>0.1.0-alpha.2</Version>
    <Authors>TheSingularityWorkshop</Authors>
    <Company>The Singularity Workshop</Company>
    <Description>Observer-aware rendering foundations built around Event Horizons and computational detail.</Description>
    <PackageTags>renderer;rendering;event-horizon;lod;graphics;observation;microbundle;protocol;semantic;performance</PackageTags>
    <RepositoryUrl>https://github.com/TrentBest/TheSingularityWorkshop.Renderer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TrentBest/TheSingularityWorkshop.Renderer</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Normal builds use released NuGet packages. Opt in explicitly for sibling-repository integration. -->
    <WorkshopUseRepositorySources Condition="'$(WorkshopUseRepositorySources)' == ''">false</WorkshopUseRepositorySources>
    <WorkshopSourceRoot Condition="'$(WorkshopSourceRoot)' == ''">$(MSBuildThisFileDirectory)..</WorkshopSourceRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(WorkshopUseRepositorySources)' != 'true'">
    <PackageReference Include="TheSingularityWorkshop.FSM_API" Version="1.0.13" />
    <PackageReference Include="TheSingularityWorkshop.ProtocolAi" Version="0.1.0-alpha.2" />
    <PackageReference Include="TheSingularityWorkshop.MicroBundleDomain" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(WorkshopUseRepositorySources)' == 'true'">
    <ProjectReference Include="$(WorkshopSourceRoot)/FSM_API/FSM_API/FSM_API.csproj" />
    <ProjectReference Include="$(WorkshopSourceRoot)/TheSingularityWorkshop.ProtocolAi/TheSingularityWorkshop.ProtocolAi.csproj" />
    <ProjectReference Include="$(WorkshopSourceRoot)/TheSingularityWorkshop.MicroBundleDomain/TheSingularityWorkshop.MicroBundleDomain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <None Update="docs/assets/moniker.svg" Pack="true" PackagePath="docs/assets/" />
  </ItemGroup>
</Project>
